#!/bin/bash
# Mirrors the epoch-670 checkpoint + model card to Hugging Face (Jetzu77/Harmonia)
# whenever you `git push`. Never blocks the actual GitHub push — HF sync
# failures are printed as a warning and swallowed.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks
#
# The checkpoint itself isn't in this repo (see .gitignore); point
# HARMONIA_CKPT_PATH at it if it's not at the default location. The
# checkpoint is only re-uploaded when its size/mtime changed since the last
# sync (tracked in .git/harmonia_hf_sync_state, never committed) — otherwise
# just the model card is refreshed, which is cheap.

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CKPT="${HARMONIA_CKPT_PATH:-/work/gerstung/RFD3-adj-ckpt/epoch-0670_localattn.ckpt}"
STATE_FILE="${REPO_ROOT}/.git/harmonia_hf_sync_state"
PYTHON="${PYTHON:-python3}"

sync_hf() {
    if ! "${PYTHON}" -c "import huggingface_hub" >/dev/null 2>&1; then
        echo "[pre-push] huggingface_hub not installed for ${PYTHON} — skipping HF sync." >&2
        return 0
    fi

    cd "${REPO_ROOT}" || return 0

    if [ -f "${CKPT}" ]; then
        fingerprint="$(stat -c '%s-%Y' "${CKPT}" 2>/dev/null)"
        previous="$(cat "${STATE_FILE}" 2>/dev/null || true)"
        if [ "${fingerprint}" != "${previous}" ]; then
            echo "[pre-push] checkpoint changed — uploading to Hugging Face (Jetzu77/Harmonia)..." >&2
            if "${PYTHON}" checkpoints/upload.py "${CKPT}"; then
                echo "${fingerprint}" > "${STATE_FILE}"
            else
                echo "[pre-push] WARNING: checkpoint upload to Hugging Face failed." >&2
            fi
            return 0
        fi
    else
        echo "[pre-push] checkpoint not found at ${CKPT} (set HARMONIA_CKPT_PATH) — only syncing model card." >&2
    fi

    echo "[pre-push] resyncing Hugging Face model card..." >&2
    "${PYTHON}" checkpoints/upload.py --skip-checkpoint || \
        echo "[pre-push] WARNING: model card sync to Hugging Face failed." >&2
}

sync_hf

exit 0
